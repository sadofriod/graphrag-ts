# PostgreSQL (schema is created with: bun run db:push)
DATABASE_URL="postgresql://user:pass@localhost:5432/graphrag?schema=public"

# Chat model for slicing (default provider: deepseek, supports openai or custom registered adapters)
# RAG_SLICE_PROVIDER=deepseek
RAG_SLICE_API_KEY=
RAG_SLICE_MODEL=deepseek-chat
RAG_SLICE_BASE_URL=https://api.deepseek.com/

# Chat model for judging (default provider: deepseek)
# RAG_JUDGE_PROVIDER=deepseek
RAG_JUDGE_API_KEY=
RAG_JUDGE_MODEL=deepseek-chat
RAG_JUDGE_BASE_URL=https://api.deepseek.com/

# Embedding model (default provider: openai; e.g. LM Studio on 127.0.0.1:1234)
# RAG_EMBED_PROVIDER=openai
RAG_EMBED_API_KEY=
RAG_EMBED_MODEL=local-embedding-model
RAG_EMBED_BASE_URL=http://127.0.0.1:1234/v1

# Community summary token budget
RAG_COMMUNITY_CONTEXT_MAX_TOKENS=4000

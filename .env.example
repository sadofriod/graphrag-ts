# PostgreSQL (schema is created with: bun run db:push)
DATABASE_URL="postgresql://user:pass@localhost:5432/graphrag?schema=public"

# Chat model for slicing (LM Studio exposes an OpenAI-compatible API)
RAG_SLICE_PROVIDER=openai
RAG_SLICE_API_KEY=lm-studio
RAG_SLICE_MODEL=google/gemma-4-12b
RAG_SLICE_BASE_URL=http://127.0.0.1:1234/v1

# Chat model for judging
RAG_JUDGE_PROVIDER=openai
RAG_JUDGE_API_KEY=lm-studio
RAG_JUDGE_MODEL=google/gemma-4-12b
RAG_JUDGE_BASE_URL=http://127.0.0.1:1234/v1

# Embedding model
RAG_EMBED_PROVIDER=openai
RAG_EMBED_API_KEY=lm-studio
RAG_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
RAG_EMBED_BASE_URL=http://127.0.0.1:1234/v1

# Community summary token budget
RAG_COMMUNITY_CONTEXT_MAX_TOKENS=4000

# Docker Compose settings (replace the password before starting)
POSTGRES_DB=graphrag
POSTGRES_USER=graphrag
POSTGRES_PASSWORD=replace-with-a-long-random-password
# URL-encode the same password for the MCP connection URL.
POSTGRES_PASSWORD_URLENCODED=replace-with-a-long-random-password
MCP_PORT=3000
INPUT_HOST_DIR=./examples/sample-corpus
MAX_HTTP_SESSIONS=100
HTTP_SESSION_IDLE_TIMEOUT_MS=900000
MAX_RETAINED_VERSIONS=3
MAX_ACTIVE_QUERIES=4

# Compose model settings; direct-library RAG_* settings above remain host-local.
COMPOSE_RAG_SLICE_BASE_URL=http://host.docker.internal:1234/v1
COMPOSE_RAG_SLICE_MODEL=local-model
COMPOSE_RAG_SLICE_API_KEY=lm-studio
COMPOSE_RAG_JUDGE_BASE_URL=http://host.docker.internal:1234/v1
COMPOSE_RAG_JUDGE_MODEL=local-model
COMPOSE_RAG_JUDGE_API_KEY=lm-studio
COMPOSE_RAG_EMBED_BASE_URL=http://host.docker.internal:1234/v1
COMPOSE_RAG_EMBED_MODEL=local-embedding-model
COMPOSE_RAG_EMBED_API_KEY=lm-studio

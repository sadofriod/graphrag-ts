# PostgreSQL (schema is created with: bun run db:push)
DATABASE_URL="postgresql://user:pass@localhost:5432/graphrag?schema=public"

# Chat model for slicing (LM Studio exposes an OpenAI-compatible API)
RAG_SLICE_PROVIDER=openai
RAG_SLICE_API_KEY=lm-studio
RAG_SLICE_MODEL=google/gemma-4-12b
RAG_SLICE_BASE_URL=http://127.0.0.1:1234/v1

# Chat model for judging
RAG_JUDGE_PROVIDER=openai
RAG_JUDGE_API_KEY=lm-studio
RAG_JUDGE_MODEL=google/gemma-4-12b
RAG_JUDGE_BASE_URL=http://127.0.0.1:1234/v1

# Embedding model
RAG_EMBED_PROVIDER=openai
RAG_EMBED_API_KEY=lm-studio
RAG_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
RAG_EMBED_BASE_URL=http://127.0.0.1:1234/v1

# Community summary token budget
RAG_COMMUNITY_CONTEXT_MAX_TOKENS=4000

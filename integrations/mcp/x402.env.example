# Optional paid query API (x402 v2). Copy the values you need into your deployment
# environment (Compose, systemd, Cloudflare Worker, ...); this file is not loaded
# automatically and the service stays disabled unless X402_ENABLED=true.
X402_ENABLED=false
# Facilitator that verifies and settles payments. PayAI needs no account to start
# (1,000 free credits) and lists this resource in its Bazaar catalog automatically
# once a payment carrying the bazaar declaration settles.
X402_FACILITATOR_URL=https://facilitator.payai.network
# Base mainnet (eip155:8453) or Base Sepolia (eip155:84532)
X402_NETWORK=eip155:8453
# USDC on Base; use 0x036CbD53842c5426634e7929541eC2318f3dCF7e for Base Sepolia
X402_ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
X402_ASSET_NAME=USDC
X402_ASSET_VERSION=2
X402_PAY_TO=<your receiving wallet>
X402_MAX_TIMEOUT_SECONDS=60
X402_DATASETS_FILE=./datasets.json
# Public origin used in the 402 challenge and /.well-known/x402; required behind a tunnel
X402_PUBLIC_BASE_URL=https://pay.example.com
